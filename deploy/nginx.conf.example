# nginx site for the Farmyard admin portal.
# Follows the same shape as the existing erp/chatwoot sites on the server.
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/admin
#   sudo ln -s /etc/nginx/sites-available/admin /etc/nginx/sites-enabled/admin
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d admin.farmyardpark.co.za
#
# certbot rewrites this file in place, adding the TLS server block and the
# port 80 -> 443 redirect, exactly as it did for erp and chatwoot.

# Optional but recommended: throttle the login endpoint so a scanner cannot
# hammer it. limit_req_zone is http-context only, so it cannot live in this
# file - put it in its own snippet:
#
#   echo 'limit_req_zone $binary_remote_addr zone=farmyard_login:10m rate=12r/m;' \
#     | sudo tee /etc/nginx/conf.d/farmyard-ratelimit.conf
#
# then uncomment the limit_req line in the /login block below.

server {
    server_name admin.farmyardpark.co.za;

    # Login is rate limited separately from the rest of the app.
    location = /login {
        # limit_req zone=farmyard_login burst=5 nodelay;

        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Required. ProxyFix reads this to build the https ticket-image URL
        # that Meta fetches; without it the link goes out as http:// and
        # WhatsApp delivery fails.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;

        # The Scripts page runs add-inventory synchronously and that drives
        # Selenium. Keep these well above the worst-case run time.
        proxy_read_timeout 1800;
        proxy_send_timeout 1800;

        client_max_body_size 16m;
    }

    listen 80;
}
