# Farmyard Manager configuration.
#
#   cp .env.example .env   and fill in the real values.
#
# This one file feeds both the application and the MySQL container, so the
# MYSQL_* values below are the credentials the database will be created with.
#
# Two rules that will bite you otherwise:
#   * Do NOT use "root" for MYSQL_USER - the mysql image refuses it.
#   * Avoid "$" in any value. Docker Compose interpolates it. PythonAnywhere
#     database names look like "user$dbname"; pick a plain name such as
#     "farmyard" instead. Write "$$" if you genuinely need a literal "$".

# ---------------------------------------------------------------- runtime ---
ENV=prod
TZ=Africa/Johannesburg

# Flask session/flash signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Signs the short-lived ticket-image URLs handed to WhatsApp. Generate the
# same way as SECRET_KEY. Changing it invalidates in-flight ticket links.
IMAGE_TOKEN_SECRET=change-me

# ------------------------------------------------------------------ login ---
# Single shared account for the admin portal. AUTH_PASSWORD_HASH holds a
# werkzeug hash, never a plaintext password. Generate one with:
#
#   docker compose run --rm web python -c \
#     "import getpass; from werkzeug.security import generate_password_hash as g; \
#      print(g(getpass.getpass('new password: ')))"
#
# Paste the result below and restart: docker compose up -d --force-recreate web
# While AUTH_PASSWORD_HASH is empty the portal fails closed - every login is
# refused rather than the site being left open.
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=

# The session cookie is marked Secure, so it is only sent over https. Set this
# false only to exercise the login over plain http locally.
SESSION_COOKIE_SECURE=true
# Kept well above the worst-case Scripts-page run so a long job cannot expire
# the session that launched it.
SESSION_LIFETIME_HOURS=12

# ---------------------------------------------------------------- database --
# MYSQL_HOST is forced to "db" by compose; this value is only used when
# running outside the stack.
MYSQL_HOST=db
# Only used outside the stack (compose.dev.yaml publishes the db on 3307).
MYSQL_PORT=3306
MYSQL_DB=farmyard
MYSQL_USER=farmyard
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# ------------------------------------------------------------------ loyverse
LOYVERSE_API_KEY=

# ------------------------------------------------------------------- quicket
QUICKET_API_KEY=
QUICKET_USER_TOKEN=
# Used by the Selenium bot to log in and hide the day's event
QUICKET_EMAIL=
QUICKET_PASSWORD=

# ------------------------------------------------------------------ chatwoot
# The WhatsApp send path for group vehicle tickets.
CHATWOOT_URL=https://chatwoot.example.co.za
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=

# ------------------------------------------------- meta whatsapp (unused) ---
# Kept for the direct-to-Meta send path, which the web app does not currently
# use. Safe to leave blank while Chatwoot is the delivery route.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# ---------------------------------------------------------------- email -----
# Failure/success notifications for the scheduled scripts.
# Use 587: Hetzner blocks outbound 25 and 465 by default. TLS mode follows the
# port (465 = implicit TLS, anything else = STARTTLS); override with
# SMTP_USE_SSL=true|false if your provider is unusual. A blocked port fails
# after SMTP_TIMEOUT seconds instead of hanging the run for two minutes.
SMTP_SERVER=mail.example.co.za
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10

# ------------------------------------------------------------- deployment ---
# The host port nginx proxies to. Bound to loopback only.
WEB_BIND=127.0.0.1
WEB_PORT=8000

# Scheme used when building the external ticket-image URL that Meta fetches.
# Must be https behind a TLS-terminating proxy.
PREFERRED_URL_SCHEME=https

# --------------------------------------------------------------- schedule ---
# The scheduler container sits behind the "scheduled" compose profile, so by
# default NOTHING runs on a timer - the jobs are manual only:
#
#   docker compose run --rm scheduler add-inventory
#   docker compose run --rm scheduler clear-inventory
#
# To turn the daily schedule ON, uncomment the line below and re-run
# `docker compose up -d`. To turn it off again, comment it out and run
# `docker compose stop scheduler && docker compose rm -f scheduler`.
#
# COMPOSE_PROFILES=scheduled

# Cron expressions used once the schedule is enabled, in TZ above.
# Defaults: morning sync 06:01, end-of-day teardown 18:00.
ADD_INVENTORY_CRON=1 6 * * *
CLEAR_INVENTORY_CRON=0 18 * * *

# --------------------------------------------------- payment audits (off) ---
# Out of scope for this deployment. The PayCloud RSA keys under keys/ are
# optional; when absent the app starts normally and only the (unregistered)
# audit blueprint is unavailable.
ADD_PAY_APP_ID=
ADD_PAY_MERCHANT_NO=

# ------------------------------------------------------- loyverse bridge ---
# Shared secret the patched Loyverse terminals send on /open_tickets/* and
# /api/stock/availability (Authorization: Bearer ...). Leave empty to keep the
# loopback-only behaviour; set it when those paths are exposed through nginx.
BRIDGE_TOKEN=

# ------------------------------------------------------- booking system ---
# See docs/booking-system.md. Generated documents, mail attachments and
# backups live under DATA_DIR (a volume in docker).
DATA_DIR=/app/data

# Bookings mailbox: the Gmail address that receives enquiries and sends
# documents. App password from myaccount.google.com/apppasswords.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Oldest mail to import into the helpdesk (YYYY-MM-DD).
GMAIL_IMPORT_SINCE=2026-06-01
# Outside ENV=prod every outbound email is redirected to this address.
DEV_MAIL_RECIPIENT=

# FNB production transaction-history API. Account = the one deposits land in.
FNB_BASE_URL=https://api.fnb.co.za/apigateway
FNB_CLIENT_ID=
FNB_CLIENT_SECRET=
FNB_ACCOUNT_NUMBER=

# Cloudflare Turnstile for the public form. Leave empty for honeypot only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Claude API key for "create booking from this email".
ANTHROPIC_API_KEY=

# Public hostname for the booking request form.
BOOKING_FORM_HOST=bookings.farmyardpark.co.za
# Origin of the admin app, used for the logo and links inside emails.
PUBLIC_BASE_URL=https://admin.farmyardpark.co.za
